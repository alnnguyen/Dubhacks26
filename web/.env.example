# Public URLs only. Copy to .env.local and restart Vite after editing.
# Shared multiplayer server (HTTPS frontend + Socket.IO endpoint).
# Leave blank to use this page's origin and the local Vite proxy.
VITE_GAME_SERVER_URL=

# Public HTTPS frontend serving /?saber=CODE, backed by that SAME game server.
# Set this when the laptop runs on localhost but phones use a teammate's tunnel.
# Leave blank to create phone links on this page's origin.
VITE_SABER_CONTROLLER_URL=
